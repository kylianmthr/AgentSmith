# Required by the current Agent Smith client.
# Add one key, or several keys separated by commas for automatic rotation.
# Never commit the populated .env file.
API_KEY=replace_with_key_1,replace_with_key_2

# Provider-specific names are conventional and may be useful for tooling.
# The current Agent Smith environment loader reads API_KEY above.
OPENROUTER_API_KEY=replace_with_openrouter_key
GROQ_API_KEY=replace_with_groq_key
TOGETHER_API_KEY=replace_with_together_key
